#!/usr/bin/env bash
# eve-telnets : ouvrir dans le terminal la console d'un nœud EVE-NG démarré.
# https://github.com/Arnaudmyges/eve-telnets · licence MIT
#
# La liste des nœuds est relue à chaque lancement, en SSH sur la VM EVE-NG :
# chaque nœud démarré y tourne dans un processus …_wrapper lancé avec
# -T <pod> -D <n° du nœud> -t <nom>, et sa console écoute sur 32768 + 128 × pod + n°.
# Rien à configurer par lab : un nœud démarré apparaît, un nœud arrêté disparaît.
#
# Console : socat (terminal brut, Ctrl+D ferme la connexion) + ncat --telnet
# (répond à la négociation telnet). Pas le client telnet : son échappement Ctrl+]
# est inaccessible sur un clavier AZERTY, et `exit` sur l'équipement ne ferme que
# la session IOS, pas la connexion.
set -euo pipefail

VERSION=0.2.0
PROG=${0##*/}
MOI=$(readlink -f "$0")

aide() {
  cat << EOF
$PROG $VERSION : console des nœuds EVE-NG démarrés, dans le terminal.

Usage :
  $PROG [-H HÔTE] [-s RECHERCHE]   choisir un nœud dans la liste, Entrée pour sa console
  $PROG -l | --list                lister les nœuds démarrés (nom, port)
  $PROG --console IP PORT [NOM]    ouvrir une console sans passer par la liste
  $PROG telnet://IP:PORT           idem, pour les liens « console native » d'EVE-NG

Dans une console : Ctrl+D pour quitter (retour à la liste), Ctrl+L pour effacer l'écran.

Options :
  -H, --host HÔTE     VM EVE-NG en SSH : alias de ~/.ssh/config ou root@IP
                      (défaut : \$EVE_TELNETS_HOST, sinon ~/.config/eve-telnets/host,
                      sinon « eve-ng »). Connexion par clé obligatoire.
  -s, --search TEXTE  liste déjà filtrée
  -h, --help          cette aide
  -V, --version       version

Sélecteur : sshs s'il est installé, sinon fzf (forcer : EVE_TELNETS_PICKER=fzf).
EOF
}

erreur() { echo "$PROG : $*" >&2; exit 1; }

verifier_outils() {
  local outil
  for outil in "$@"; do
    command -v "$outil" > /dev/null || erreur "$outil absent (voir le README, section Installation)"
  done
}

# console IP PORT [NOM] : ouvre la console et rend la main quand on la quitte.
# socat lit le clavier ; il passe par filtre_clavier (Ctrl+L) avant ncat, via
# `eve-telnets --tuyau`. Si le chemin du script gêne socat (espace, virgule…),
# console sans le filtre : tout marche sauf l'effacement par Ctrl+L.
console() {
  verifier_outils socat ncat
  [[ $1 =~ ^[A-Za-z0-9._:-]+$ && $2 =~ ^[0-9]+$ ]] || erreur "adresse invalide : $1 $2"
  printf '\e[2m── %s · Ctrl+D pour quitter, Ctrl+L pour effacer ──\e[0m\n' "${3:-$1:$2}"
  local cible="ncat --telnet $1 $2"
  if [[ $MOI =~ ^[A-Za-z0-9/._+-]+$ ]]; then cible="$MOI --tuyau $1 $2"; fi
  socat -,rawer,escape=0x04 "EXEC:$cible"
}

# Clavier → équipement à l'identique, sauf Ctrl+L qui efface aussi l'écran du
# terminal ; l'équipement le reçoit quand même et réaffiche l'invite, en haut.
# Octet par octet (LC_ALL=C) : rapide assez pour coller une configuration.
filtre_clavier() {
  local LC_ALL=C c
  while IFS= read -r -d '' -n 1 c; do
    if [ -z "$c" ]; then printf '\0'; continue; fi   # octet nul (Ctrl+Espace)
    if [ "$c" = $'\f' ]; then { printf '\e[H\e[2J\e[3J' > /dev/tty; } 2> /dev/null || true; fi
    printf '%s' "$c"
  done
}

hote_eve() {
  local f=${XDG_CONFIG_HOME:-$HOME/.config}/eve-telnets/host
  if [ -n "${HOTE:-}" ]; then echo "$HOTE"
  elif [ -n "${EVE_TELNETS_HOST:-}" ]; then echo "$EVE_TELNETS_HOST"
  elif [ -s "$f" ]; then head -1 "$f"
  else echo eve-ng
  fi
}

# Adresse de la VM telle que ssh la résout (alias ou user@IP)
ip_eve() { ssh -G "$1" 2> /dev/null | awk '$1 == "hostname" { print $2; exit }'; }

# lister HÔTE : « nom<TAB>port » par nœud démarré, trié par nom, sans doublon
# (un nœud IOL tourne dans 2 processus) ; le pod est ajouté au nom s'il n'est pas 0
lister() {
  local procs err
  err=$(mktemp)
  # Erreurs SSH gardées de côté : affichées seulement en cas d'échec (sinon
  # l'avertissement « post-quantum » du vieil OpenSSH d'EVE-NG à chaque lancement)
  if ! procs=$(ssh -o BatchMode=yes -o ConnectTimeout=5 "$1" 'ps -eo args=' 2> "$err" < /dev/null); then
    cat "$err" >&2
    rm -f "$err"
    erreur "$1 injoignable en SSH par clé (ssh-copy-id $1 ?)"
  fi
  rm -f "$err"
  awk '
    $1 ~ /\/[a-z0-9]+_wrapper$/ {
      T = ""; D = ""; t = ""
      for (i = 2; i <= NF && $i != "--"; i++) {
        if ($i == "-T") T = $(i + 1)
        else if ($i == "-D") D = $(i + 1)
        else if ($i == "-t") { t = $(++i); while (i < NF && $(i + 1) !~ /^-/) t = t "-" $(++i) }
      }
      if (T !~ /^[0-9]+$/ || D !~ /^[0-9]+$/) next
      gsub(/"/, "", t)
      if (t == "") t = "noeud-" D
      if (T != 0) t = t "-pod" T
      print t "\t" 32768 + 128 * T + D
    }' <<< "$procs" | sort -fu
}

# Lien telnet://IP:PORT (console native d'EVE-NG) : nom du nœud retrouvé si possible
ouvrir_url() {
  local reste=${1#telnet://} ip port nom=""
  reste=${reste%%/*}
  ip=${reste%:*} port=${reste##*:}
  [ "$ip" != "$reste" ] || port=23
  [[ $port =~ ^[0-9]+$ ]] || erreur "lien invalide : $1"
  if [ "$(ip_eve "$(hote_eve)")" = "$ip" ]; then
    nom=$(lister "$(hote_eve)" 2> /dev/null | awk -F'\t' -v p="$port" '$2 == p { print $1; exit }') || true
  fi
  console "$ip" "$port" "$nom"
}

choisir_sshs() {
  local ip=$1 noeuds=$2
  # Globale : le trap s'exécute après la fin de la fonction
  LISTE=$(mktemp -p "${XDG_RUNTIME_DIR:-/tmp}" eve-telnets.XXXXXX)
  trap 'rm -f "$LISTE"' EXIT
  awk -F'\t' -v ip="$ip" '{ printf "Host %s\n  HostName %s\n  Port %s\n\n", $1, ip, $2 }' \
    <<< "$noeuds" > "$LISTE"
  sshs -c "$LISTE" --color green --no-sort ${RECHERCHE:+-s "$RECHERCHE"} \
    -t "\"$MOI\" --console \"{{{destination}}}\" \"{{{port}}}\" \"{{{name}}}\""
}

choisir_fzf() {
  local ip=$1 noeuds=$2 ligne
  while ligne=$(fzf --height=~50% --reverse --prompt='console> ' --delimiter='\t' \
    --with-nth=1 --header='Entrée : console · Ctrl+D dans la console : retour ici · Échap : quitter' \
    ${RECHERCHE:+--query "$RECHERCHE"} <<< "$noeuds"); do
    console "$ip" "${ligne##*$'\t'}" "${ligne%%$'\t'*}" || true
  done
}

HOTE="" RECHERCHE="" MODE=choisir
while [ $# -gt 0 ]; do
  case $1 in
    -h | --help) aide; exit ;;
    -V | --version) echo "$PROG $VERSION"; exit ;;
    -H | --host) HOTE=${2:?"$PROG : -H HÔTE"}; shift 2 ;;
    -s | --search) RECHERCHE=${2:?"$PROG : -s TEXTE"}; shift 2 ;;
    -l | --list) MODE=lister; shift ;;
    --console)
      [ $# -ge 3 ] || erreur "usage : $PROG --console IP PORT [NOM]"
      console "$2" "$3" "${4:-}"; exit ;;
    --tuyau) filtre_clavier | ncat --telnet "$2" "$3"; exit ;;   # interne, lancé par socat (console)
    telnet://*) ouvrir_url "$1"; exit ;;
    *) erreur "option inconnue : $1 (voir $PROG --help)" ;;
  esac
done

hote=$(hote_eve)
noeuds=$(lister "$hote")
if [ "$MODE" = lister ]; then
  [ -z "$noeuds" ] || printf '%s\n' "$noeuds"
  exit
fi
[ -n "$noeuds" ] || erreur "aucun nœud démarré sur EVE-NG ($hote)"
ip=$(ip_eve "$hote")

case ${EVE_TELNETS_PICKER:-} in
  fzf) verifier_outils fzf; choisir_fzf "$ip" "$noeuds" ;;
  sshs) verifier_outils sshs; choisir_sshs "$ip" "$noeuds" ;;
  *)
    if command -v sshs > /dev/null; then choisir_sshs "$ip" "$noeuds"
    elif command -v fzf > /dev/null; then choisir_fzf "$ip" "$noeuds"
    else erreur "installer sshs ou fzf pour choisir un nœud (ou utiliser --list et --console)"
    fi ;;
esac
